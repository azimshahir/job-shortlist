# Copy to .env.local for local dev. NEVER commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Scrape sekarang / Tailored Resume buttons (server-only)
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=azimshahir/job-shortlist
# queue (default, no API key) | api (dispatches resume.yml)
RESUME_MODE=queue

# Frontend (build-time, public)
# "true" once candidate_profile.yaml has no TODO_ placeholders; enables Minta resume
NEXT_PUBLIC_RESUME_PREREQ_OK=false
# Mirrors scraper/config.py FINAL_SCORE_THRESHOLD for the "bawah 60" badge
NEXT_PUBLIC_FINAL_SCORE_THRESHOLD=60
